{
  "name": "xiaofei-background-remover",
  "version": "1.0.0",
  "description": "AI背景去除工具 - 使用本地RMBG模型",
  "main": "dist/main/main.js",
  "author": "小飞",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.main.json && electron .",
    "build": "npm run build:renderer && npm run copy-images && npm run build:electron",
    "build:renderer": "vite build",
    "copy-images": "cp resource/qrcode.jpg resource/grcode.jpg dist/renderer/",
    "build:electron": "tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder --mac",
    "package:tauri": "npm run build:renderer && npx tauri build",
    "start": "electron ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "omggif": "^1.0.10",
    "onnxruntime-node": "^1.24.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.3.1",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.xiaofei.background-remover",
    "productName": "小飞AI抠图",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "backend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "venv-minimal",
        "to": "venv"
      },
      {
        "from": "dist/renderer",
        "to": "dist/renderer"
      },
      {
        "from": "resource/qrcode.jpg",
        "to": "resource/qrcode.jpg"
      },
      {
        "from": "resource/grcode.jpg",
        "to": "resource/grcode.jpg"
      },
      {
        "from": "resource/logo.png",
        "to": "resource/logo.png"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "resource/logo.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resource/logo.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "logo.png"
    },
    "asar": {
      "smartUnpack": false
    },
    "electronLanguages": [
      "zh_CN",
      "en"
    ]
  }
}
