{
  "name": "xiaofei-background-remover",
  "version": "1.0.2",
  "description": "AI背景去除工具 - 使用本地RMBG模型",
  "main": "dist/main/main.js",
  "author": "小飞",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.main.json && electron .",
    "build": "npm run build:renderer && npm run copy-images && npm run build:electron",
    "build:renderer": "vite build",
    "copy-images": "cp resource/qrcode.jpg resource/grcode.jpg dist/renderer/",
    "build:electron": "tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder --mac --win --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "start": "electron ."
  },
  "dependencies": {
    "omggif": "^1.0.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.3.1",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.xiaofei.background-remover",
    "productName": "小飞AI抠图",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "backend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "venv-arm64",
        "to": "venv-arm64"
      },
      {
        "from": "venv-x64",
        "to": "venv-x64"
      },
      {
        "from": "venv-minimal",
        "to": "venv"
      },
      {
        "from": "model_files",
        "to": "model_files"
      },
      {
        "from": "resource/qrcode.jpg",
        "to": "resource/qrcode.jpg"
      },
      {
        "from": "resource/grcode.jpg",
        "to": "resource/grcode.jpg"
      },
      {
        "from": "resource/logo.png",
        "to": "resource/logo.png"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "resource/logo.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resource/logo.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resource/logo.png"
    },
    "asar": {
      "smartUnpack": false
    },
    "electronLanguages": [
      "zh_CN",
      "en"
    ]
  }
}
