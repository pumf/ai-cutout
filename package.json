{
  "name": "xiaofei-background-remover",
  "version": "1.0.0",
  "description": "AI背景去除工具 - 使用本地RMBG-2.0模型",
  "main": "dist/main/main.js",
  "author": "小飞",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.main.json && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder --mac",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.3.1",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.xiaofei.background-remover",
    "productName": "小飞AI抠图",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "backend/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "model_files",
        "to": "model_files"
      },
      {
        "from": "venv",
        "to": "venv"
      },
      {
        "from": "dist/renderer",
        "to": "dist/renderer"
      },
      {
        "from": "node_modules/vite",
        "to": "node_modules/vite"
      },
      {
        "from": "node_modules/@vitejs",
        "to": "node_modules/@vitejs"
      },
      {
        "from": "node_modules/esbuild",
        "to": "node_modules/esbuild"
      },
      {
        "from": "node_modules/rollup",
        "to": "node_modules/rollup"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    },
    "asar": false
  }
}
